[Unit]
Description=Guciocraft Next.js
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guciocraft
Group=guciocraft
WorkingDirectory=/opt/guciocraft
Environment=NODE_ENV=production
Environment=BIND_ADDRESS=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/etc/guciocraft.env
ExecStart=/usr/bin/node scripts/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guciocraft /opt/guciocraft/.next/standalone/.next/cache
RestrictSUIDSGID=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
