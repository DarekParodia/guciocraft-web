# Skopiuj do .env.local przy lokalnej pracy lub /etc/guciocraft.env przy systemd.
# Next.js musi działać za reverse proxy, które NADPISUJE X-Real-IP.
SITE_ORIGIN=https://guciocraft.example.com
CLIENT_IP_HEADER=x-real-ip
WHITELIST_ENABLED=false

# Dane RCON wyłącznie serwerowe. Hasło losowe, co najmniej 24 znaki.
# Port dostępny tylko z hosta/LXC aplikacji. Nie wystawiaj go do internetu.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

MC_HOST=mc.bshomelab.cc
MC_PORT=25565
DATABASE_PATH=./data/guciocraft.sqlite
DOWNLOAD_DIR=./downloads

NEXT_TELEMETRY_DISABLED=1
BIND_ADDRESS=127.0.0.1
